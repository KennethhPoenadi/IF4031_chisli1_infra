          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, app_kubernetes_io_name) (rate(http_server_request_duration_seconds_bucket{app_kubernetes_io_name=~\"$app\"}[2m])))",
          "legendFormat": "{{app_kubernetes_io_name}}",
          "refId": "A"
