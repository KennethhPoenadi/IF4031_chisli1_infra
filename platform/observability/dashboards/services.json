  "templating": {
    "list": [
      {
        "name": "app",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "query": {
          "query": "label_values(http_server_request_duration_seconds_count, app_kubernetes_io_name)",
          "refId": "app"
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  }
