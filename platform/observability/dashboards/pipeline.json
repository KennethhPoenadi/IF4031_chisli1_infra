{
  "uid": "bnpb-pipeline",
  "title": "BNPB / Alur data dan jalur peringatan",
  "description": "Latensi jalur peringatan terhadap target 5 detik, ingest, dan kesehatan penyimpanan tersebar.",
  "tags": [
    "bnpb",
    "m2"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "graphTooltip": 1,
  "panels": [
    {
      "id": 13,
      "type": "row",
      "title": "Jalur peringatan (SLO)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 14,
      "type": "stat",
      "title": "p95 latensi notifikasi",
      "description": "Detik dari event disimpan aggregator sampai notifier memprosesnya. Target: ≤ 5 detik.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 3
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(notification_latency_seconds_bucket[5m])))",
          "legendFormat": "{{unit}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Pesan diproses ≤ 5 detik",
      "description": "SLO jalur peringatan: persentase pesan diproses dalam 5 detik (aturan rekaman, jendela 5 menit).",
